#!/bin/sh
# Minimal Maven wrapper: downloads Maven once into ~/.m2/wrapper, verifies it, then runs it.
# No Homebrew or admin rights needed. Usage: ./mvnw test, ./mvnw spring-boot:run
set -e

MAVEN_VERSION=3.9.11
WRAPPER_DIR="$HOME/.m2/wrapper"
MAVEN_HOME="$WRAPPER_DIR/apache-maven-$MAVEN_VERSION"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Downloading Maven $MAVEN_VERSION (one time only)..."
  mkdir -p "$WRAPPER_DIR"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  TMP="$WRAPPER_DIR/maven-$MAVEN_VERSION.tar.gz"
  curl -fsSL "$URL" -o "$TMP"
  EXPECTED="$(curl -fsSL "$URL.sha512" | cut -d' ' -f1)"
  ACTUAL="$(shasum -a 512 "$TMP" | cut -d' ' -f1)"
  if [ "$EXPECTED" != "$ACTUAL" ]; then
    echo "Checksum mismatch for the Maven download. Aborting." >&2
    rm -f "$TMP"
    exit 1
  fi
  tar -xzf "$TMP" -C "$WRAPPER_DIR"
  rm -f "$TMP"
  echo "Maven $MAVEN_VERSION installed in $MAVEN_HOME"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
